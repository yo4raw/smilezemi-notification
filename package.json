{
  "name": "smilezemi-notification",
  "version": "1.0.0",
  "description": "スマイルゼミ みまもるネット 自動クローリング & LINE通知",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "oxlint --deny-warnings src",
    "lint:fix": "oxlint --fix src",
    "test": "node --test --test-force-exit --experimental-test-isolation=none tests/*.test.js",
    "test:watch": "node --test --test-force-exit --experimental-test-isolation=none --watch tests/*.test.js",
    "docker:build": "docker-compose build",
    "docker:run": "docker-compose up",
    "docker:dev": "docker-compose run --rm crawler",
    "install:browsers": "npx playwright install chromium --with-deps",
    "validate:env": "node scripts/validate-env.js",
    "validate:security": "bash scripts/validate-security.sh",
    "validate:all": "npm run validate:env && npm run validate:security",
    "test:docker": "bash scripts/test-docker.sh"
  },
  "keywords": [
    "smile-zemi",
    "crawler",
    "line-notify",
    "github-actions"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "oxlint": "1.74.0"
  }
}
