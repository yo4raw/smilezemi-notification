{
  "name": "smilezemi-notification",
  "version": "1.1.0",
  "description": "スマイルゼミ みまもるネット 自動クローリング & LINE通知",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then git config core.hooksPath .githooks; fi",
    "lint": "oxlint --deny-warnings src",
    "lint:fix": "oxlint --fix src",
    "test": "node --test --test-force-exit --experimental-test-isolation=none tests/*.test.js",
    "test:watch": "node --test --test-force-exit --experimental-test-isolation=none --watch tests/*.test.js",
    "docker:build": "docker-compose build",
    "docker:run": "docker-compose up",
    "docker:dev": "docker-compose run --rm crawler",
    "install:browsers": "npx playwright install chromium --with-deps"
  },
  "keywords": [
    "smile-zemi",
    "crawler",
    "line-notify",
    "github-actions"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "oxlint": "1.74.0"
  }
}
